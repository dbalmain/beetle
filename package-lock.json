{
  "name": "beetle",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "beetle",
      "version": "0.0.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@beetle/bench": {
      "resolved": "packages/bench",
      "link": true
    },
    "node_modules/@beetle/contract": {
      "resolved": "packages/contract",
      "link": true
    },
    "node_modules/@beetle/vici-js": {
      "resolved": "packages/vici-js",
      "link": true
    },
    "node_modules/@beetle/vici-wasm": {
      "resolved": "packages/vici-wasm",
      "link": true
    },
    "packages/bench": {
      "name": "@beetle/bench",
      "version": "0.0.0"
    },
    "packages/contract": {
      "name": "@beetle/contract",
      "version": "0.0.0"
    },
    "packages/vici-js": {
      "name": "@beetle/vici-js",
      "version": "0.0.0"
    },
    "packages/vici-wasm": {
      "name": "@beetle/vici-wasm",
      "version": "0.0.0"
    }
  }
}
